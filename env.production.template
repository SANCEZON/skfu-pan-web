# Переменные окружения для фронтенда (TimeWeb / Supabase)
# Скопируйте этот файл в .env и заполните значениями из проекта Supabase

# URL проекта Supabase (пример: https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Публичный anon key Supabase (из Project Settings → API)
VITE_SUPABASE_ANON_KEY=your-anon-key

